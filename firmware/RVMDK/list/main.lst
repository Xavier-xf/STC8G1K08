 137          /* 最长约 140 字符；改动字段须同步复核 cpu_check_link.c 的 LINK_HANDOFF_MS 预算。 */
 138          static void app_report(const heartbeat_monitor_t *heartbeat,
 139                                 heartbeat_monitor_status_t heartbeat_status,
 140                                 heartbeat_monitor_ms_t now_ms)
 141          {
 142   1          uart1_puts("reset heartbeat=");
 143   1          uart1_puts(heartbeat_status_name(heartbeat_status));
 144   1          uart1_puts(" state=");
 145   1          uart1_puts(reset_state_name(g_reset_controller.state));
 146   1          uart1_puts(" edges=");
 147   1          uart1_put_u32(heartbeat->edge_count);
 148   1          uart1_puts(" age_ms=");
 149   1          uart1_put_u32((unsigned long)(now_ms - heartbeat->last_edge_ms));
 150   1          uart1_puts(" seen=");
 151   1          uart1_putc(heartbeat->edge_seen != 0U ? '1' : '0');
 152   1          uart1_puts(" P54=");
 153   1          uart1_putc(CPU_CHECK ? '1' : '0');
 154   1          uart1_puts(" P55=");
 155   1          uart1_putc(AP_RESET ? '1' : '0');
 156   1          uart1_puts(" output=");
 157   1          uart1_puts(g_reset_output_active ? "assert" : "power-on");
 158   1          uart1_puts(" resets=");
 159   1          uart1_put_u32(g_reset_controller.reset_count);
 160   1          uart1_puts(" wdt=on\r\n");
 161   1      }
 162          #endif
