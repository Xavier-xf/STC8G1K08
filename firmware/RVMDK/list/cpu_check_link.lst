 146   2              state = LINK_RECEIVE;
 147   2          } else {
 148   2              if (!((interval >= LINK_ZERO_MS - LINK_TOLERANCE_MS &&
 149   2                     interval <= LINK_ZERO_MS + LINK_TOLERANCE_MS) ||
 150   2                    (interval >= LINK_ONE_MS - LINK_TOLERANCE_MS &&
