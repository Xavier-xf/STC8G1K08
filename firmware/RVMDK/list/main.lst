 164          /* 运行期 P5.5 的唯一改动入口。 */
 165          static void apply_reset_output(unsigned char active)
 166          {
 167   1          if (active == g_reset_output_active) return;
 168   1          if (active != 0U) {
 169   2              ap_reset_assert();
 170   2          } else {
 171   2              ap_reset_release();
 172   2          }
 173   1          g_reset_output_active = active;
 174   1      #if STC8G1K08_UART_LOG_ENABLE
 175   1          uart1_puts(active != 0U ? "AP_RESET assert\r\n" :
 176   1                                   "AP_RESET release\r\n");
 177   1      #endif
 178   1      }
