 177          
 178          static void apply_reset_output(unsigned char active)
C51 COMPILER V9.54   MAIN                                                                  08/21/2026 10:55:33 PAGE 4   

 179          {
 180   1          if (active == g_reset_output_active) return;
 181   1          if (active != 0U) {
 182   2              ap_reset_assert();
 183   2          } else {
 184   2              ap_reset_release();
 185   2          }
 186   1          g_reset_output_active = active;
