  41   1          P5M0 &= (unsigned char)~P5_AP_RESET_MASK;
  42   1          P5 |= P5_AP_RESET_MASK;
  43   1      }
  44          
  45          static void ap_reset_assert(void)
  46          {
  47   1          /* 先回到高阻，再预置锁存值，最后切换推挽，避免切换瞬间毛刺。 */
  48   1          ap_reset_release();
  49   1          #if AP_RESET_ASSERT_LEVEL != 0U
                      P5 |= P5_AP_RESET_MASK;
              #else
  52   1              P5 &= (unsigned char)~P5_AP_RESET_MASK;
  53   1      #endif
  54   1          P5M1 &= (unsigned char)~P5_AP_RESET_MASK;
