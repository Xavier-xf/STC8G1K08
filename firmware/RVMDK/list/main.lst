 100          /* 从停止进入监测：清空本轮心跳并重新开始宽限。此时复位输出必为释放。 */
 101          static void monitor_restart(heartbeat_monitor_ms_t now_ms)
 102          {
 103   1          unsigned char saved_ea = EA;
 104   1      
 105   1          EA = 0;
 106   1          heartbeat_monitor_init(&g_heartbeat_monitor, now_ms);
 107   1          reset_controller_init(&g_reset_controller, now_ms);
 108   1          EA = saved_ea;
 109   1      }
