 198          static void app_init(void)
 199          {
 200   1          unsigned char reset_cause;
 201   1          unsigned char wdt_reset;
 202   1          unsigned char power_or_lvd_reset;
 203   1      
 204   1          /* 必须在 wdt_init() 改写 WDT_CONTR 之前取样复位原因。 */
 205   1          reset_cause = (unsigned char)((PCON & (PCON_POF_MASK | PCON_LVDF_MASK)) |
