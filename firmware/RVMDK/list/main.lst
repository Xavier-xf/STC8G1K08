 251          static void app_run(void)
 252          {
 253   1          heartbeat_monitor_ms_t last_report;
 254   1          heartbeat_monitor_ms_t now_ms;
 255   1          heartbeat_monitor_t heartbeat;
 256   1          heartbeat_monitor_status_t heartbeat_status;
 257   1          unsigned char command;
 258   1          unsigned char reply_result;
 259   1          unsigned char reply_status;
 260   1      
 261   1          last_report = millis_snapshot();
 262   1          for (;;) {
 263   2              heartbeat_snapshot(&heartbeat, &now_ms);
 264   2      
 265   2              EA = 0;
 266   2              command = cpu_check_link_poll();
 267   2              EA = 1;
 268   2              if (command) {
 269   3                  reply_result = LINK_RESULT_OK;
 270   3                  if (command == LINK_COMMAND_START) {
 271   4                      /* 已启用时重复 START 不重置宽限和状态。 */
 272   4                      if (!g_monitor_enabled) {
 273   5                          g_monitor_enabled = 1U;
 274   5                          monitor_restart(now_ms);
 275   5                          heartbeat_snapshot(&heartbeat, &now_ms);
 276   5                      }
 277   4                  } else if (command == LINK_COMMAND_STOP) {
 278   4                      /* 先释放复位输出，使应答状态与引脚一致。 */
 279   4                      g_monitor_enabled = 0U;
 280   4                      apply_reset_output(0U);
 281   4                  } else if (command != LINK_COMMAND_READ) {
 282   4                      reply_result = LINK_RESULT_INVALID;
 283   4                  }
 284   3                  reply_status = g_monitor_enabled ? LINK_STATUS_ENABLED : 0U;
 285   3                  if (heartbeat.edge_seen) reply_status |= LINK_STATUS_HEARTBEAT;
 286   3                  if (g_monitor_enabled)
 287   3                      reply_status |= (unsigned char)((g_reset_controller.state + 1U) <<
 288   3                                                      LINK_STATUS_PHASE_SHIFT);
 289   3                  EA = 0;
 290   3                  cpu_check_link_reply(reply_result, reply_status);
 291   3                  EA = 1;
 292   3              }
 293   2      
 294   2              /* 监测停止：复位输出已在 STOP 时释放，内部 WDT 继续运行。 */
 295   2              if (!g_monitor_enabled) {
 296   3                  wdt_clear();
 297   3      #if STC8G1K08_UART_LOG_ENABLE
 298   3                  if ((heartbeat_monitor_ms_t)(now_ms - last_report) >= 1000UL) {
 299   4                      last_report = now_ms;
 300   4                      uart1_puts("MNT mode=stopped edges=");
 301   4                      uart1_put_u32(heartbeat.edge_count);
C51 COMPILER V9.54   MAIN                                                                  11/26/2026 11:23:14 PAGE 6   

 302   4                      uart1_puts("\r\n");
 303   4                  }
 304   3      #endif
 305   3                  continue;
 306   3              }
 307   2      
 308   2              /* 监测已启动：执行心跳超时和 AP_RESET 逻辑。 */
 309   2              heartbeat_status = heartbeat_monitor_status(
 310   2                  &heartbeat, now_ms, reset_grace_ms(), HEARTBEAT_MONITOR_TIMEOUT_MS);
 311   2              reset_controller_update(&g_reset_controller, heartbeat_status, now_ms,
 312   2                                      AP_RESET_PULSE_MS, RESET_RECOVERY_WINDOW_MS);
 313   2              apply_reset_output(reset_controller_output_active(&g_reset_controller));
 314   2              wdt_clear();
 315   2      #if STC8G1K08_UART_LOG_ENABLE
 316   2              if ((heartbeat_monitor_ms_t)(now_ms - last_report) >= 1000UL) {
 317   3                  last_report = now_ms;
 318   3                  app_report(&heartbeat, heartbeat_status, now_ms);
 319   3              }
 320   2      #endif
 321   2          }
 322   1      }
