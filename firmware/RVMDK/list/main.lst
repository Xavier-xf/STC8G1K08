 121          #if STC8G1K08_UART_LOG_ENABLE
 122          static const char *heartbeat_status_name(heartbeat_monitor_status_t status)
 123          {
 124   1          if (status == HEARTBEAT_MONITOR_STARTUP) return "startup";
 125   1          if (status == HEARTBEAT_MONITOR_HEALTHY) return "healthy";
 126   1          return "timeout";
 127   1      }
 128          
 129          static const char *reset_state_name(reset_controller_state_t state)
 130          {
 131   1          if (state == RESET_CONTROLLER_STARTUP) return "startup";
 132   1          if (state == RESET_CONTROLLER_MONITORING) return "monitoring";
 133   1          if (state == RESET_CONTROLLER_ASSERT) return "assert";
 134   1          return "wait-recovery";
 135   1      }
