 180          void timer0_isr(void) interrupt 1
 181          {
 182   1          TH0 = (unsigned char)(TIMER0_RELOAD >> 8);
 183   1          TL0 = (unsigned char)TIMER0_RELOAD;
 184   1          ++g_millisecond;
 185   1          cpu_check_link_tick();
 186   1      }
 187          
 188          void int2_isr(void) interrupt 10
 189          {
 190   1          heartbeat_monitor_ms_t now_ms = g_millisecond;
 191   1          unsigned int age_ms = cpu_check_link_on_falling_edge((unsigned int)now_ms);
 192   1      
 193   1          /* 只记录已确认的普通心跳；协议边沿和自身应答返回 0。 */
 194   1          if (age_ms)
 195   1              heartbeat_monitor_on_falling_edge(&g_heartbeat_monitor, now_ms - age_ms);
 196   1      }
