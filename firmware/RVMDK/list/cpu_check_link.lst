 186          /* 应答：命令/拒绝/状态、原序号、CRC。期限已过的事务不再应答。 */
 187          void cpu_check_link_reply(unsigned char result, unsigned char status)
 188          {
 189   1          if (state != LINK_EXECUTING) return;
