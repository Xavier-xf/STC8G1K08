  39   1      #else
                  P5 |= P5_AP_RESET_MASK;
              #endif
  42   1      }
  43          
  44          static void ap_reset_assert(void)
  45          {
  46   1          /* 始终保持推挽模式，只切换输出电平。 */
  47   1      #if AP_RESET_ASSERT_LEVEL != 0U
  48   1          P5 |= P5_AP_RESET_MASK;
  49   1      #else
                  P5 &= (unsigned char)~P5_AP_RESET_MASK;
              #endif
  52   1      }
