 111          /*
 112           * 开机宽限只属于 STARTUP 阶段。其余阶段传 0，避免运行约 49.7 天后
 113           * 32 位差值回绕而再次报告 STARTUP，导致 30 s 内主机死机不被复位。
 114           */
 115          static heartbeat_monitor_ms_t reset_grace_ms(void)
 116          {
C51 COMPILER V9.54   MAIN                                                                  11/26/2026 11:23:14 PAGE 3   

 117   1          return g_reset_controller.state == RESET_CONTROLLER_STARTUP ?
 118   1                 RESET_HEARTBEAT_GRACE_MS : 0UL;
 119   1      }
