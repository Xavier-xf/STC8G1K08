  30   1          TH0 = (unsigned char)(TIMER0_RELOAD >> 8);
  31   1          TL0 = (unsigned char)TIMER0_RELOAD;
  32   1          TF0 = 0;
  33   1          ET0 = 1;
  34   1          TR0 = 1;
  35   1      }
