 201          void int2_isr(void) interrupt 10
 202          {
 203   1          heartbeat_monitor_ms_t now_ms = g_millisecond;
 204   1      
 205   1          /* 1. 先更新心跳监控（AP_RESET 决策的关键数据）*/
 206   1          heartbeat_monitor_on_falling_edge(&g_heartbeat_monitor, now_ms);
