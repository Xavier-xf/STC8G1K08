 178          static void apply_reset_output(unsigned char active)
C51 COMPILER V9.54   MAIN                                                                  08/25/2026 15:34:06 PAGE 4   

 179          {
 180   1          if (active == g_reset_output_active) return;
 181   1          if (active != 0U) {
 182   2              ap_reset_assert();
